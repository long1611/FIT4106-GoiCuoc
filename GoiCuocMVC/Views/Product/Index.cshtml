@model IEnumerable<GoiCuocMVC.Models.Product>

@{
    ViewData["Title"] = "Danh sách gói cước";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Danh sách gói cước</h2>
    <a asp-controller="Product" asp-action="Create" class="btn btn-success">+ Thêm gói cước</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có gói cước nào. Hãy bấm "Thêm gói cước" để tạo mới.</div>
}
else
{
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-primary">
            <tr>
                <th>@Html.DisplayNameFor(m => m.Id)</th>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th>@Html.DisplayNameFor(m => m.Category)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Price)</th>
                <th class="text-center">@Html.DisplayNameFor(m => m.ValidityDays)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.Category</td>
                    <td class="text-end">@item.Price?.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))</td>
                    <td class="text-center">@item.ValidityDays</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Tổng số: @Model.Count() gói cước</p>
}
