@model GoiCuocMVC.Models.Product

@{
    ViewData["Title"] = "Thêm gói cước";
}

<h2 class="mb-3">Thêm gói cước mới</h2>

<div class="card shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Ví dụ: DATA70" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select">
                    <option value="">-- Chọn loại gói --</option>
                    <option>Gói data</option>
                    <option>Gói ngày</option>
                    <option>Gói thoại</option>
                    <option>Gói combo</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" placeholder="Ví dụ: 70000" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ValidityDays" class="form-label"></label>
                    <input asp-for="ValidityDays" class="form-control" placeholder="Ví dụ: 30" />
                    <span asp-validation-for="ValidityDays" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
